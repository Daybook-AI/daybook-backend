# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Use long, independent random values for these signing secrets.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated exact origins when deploying more than one frontend.
FRONTEND_ORIGINS="http://localhost:4200"
# strict or lax for same-site deployments; use none only with production HTTPS.
COOKIE_SAME_SITE="strict"

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
